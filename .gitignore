# Root gitignore
.sixth/

# Local testing directories
test/
tests/

# Keep app regression tests in version control; other test artifacts stay local.
!e-commerce/tests/
e-commerce/tests/*
!e-commerce/tests/*.test.cjs

# Next.js generates these agent files at the app root.
# Keep Markdown instructions in skills or local docs instead.
AGENTS.md
CLAUDE.md

# Local machine settings and temporary files
.codex/
.aws/
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.temp
