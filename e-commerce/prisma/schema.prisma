datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                       String      @id @default(auto()) @map("_id") @db.ObjectId
  name                     String?
  email                    String?     @unique
  emailVerified            DateTime?
  image                    String?
  address                  String?
  phoneNumber              String?
  accounts                 Account[]
  hashedPassword           String?
  role                     Role        @default(USER)
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  status                   UserStatus? @default(ACTIVE)
  sessionVersion           Int?        @default(0)
  pendingEmail             String?
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  emailVerificationVersion Int?
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  orders                   Order[]
}

enum Role {
  USER
  ADMIN
}

model ProductReview {
  id         String   @id @map("_id")
  userId     String   @db.ObjectId
  productId  String   @db.ObjectId
  orderId    String   @db.ObjectId
  rating     Int
  comment    String
  authorName String
  createdAt  DateTime @default(now())

  @@index([productId, createdAt])
}

model WishlistItem {
  id        String   @id @map("_id")
  userId    String   @db.ObjectId
  productId String   @db.ObjectId
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

model AuthRateLimit {
  id        String   @id @map("_id")
  attempts  Int
  expiresAt DateTime

  @@index([expiresAt])
}

model CheckoutRequest {
  id               String   @id @map("_id")
  userId           String   @db.ObjectId
  fingerprint      String
  paymentMethod    String
  paymentReference String
  orderId          String?  @db.ObjectId
  createDate       DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId    String   @db.ObjectId
  action     String
  entityType String
  entityId   String
  status     String   @default("STARTED")
  details    Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
}

model OperationalJob {
  id              String    @id @map("_id")
  status          String    @default("IDLE")
  leaseToken      String?
  leaseExpiresAt  DateTime?
  startedAt       DateTime?
  finishedAt      DateTime?
  lastSucceededAt DateTime?
  runCount        Int       @default(0)
  metrics         Json?
  incidentId      String?
}

model OperationalIncident {
  id        String   @id @map("_id")
  category  String
  route     String?
  digest    String?
  createdAt DateTime @default(now())
}

model NotificationDelivery {
  id             String    @id @map("_id")
  eventId        String
  recipientId    String    @db.ObjectId
  orderId        String    @db.ObjectId
  subject        String
  href           String
  amount         Float
  currency       String
  state          String    @default("PENDING")
  version        Int       @default(1)
  attempts       Int       @default(0)
  autoAttempts   Int       @default(0)
  nextAttemptAt  DateTime? @default(now())
  toEmail        String?
  resultCode     String?
  leaseToken     String?
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([state, nextAttemptAt])
  @@index([orderId, createdAt])
}

model NotificationEvent {
  id        String   @id @map("_id")
  kind      String
  entityId  String   @db.ObjectId
  createdAt DateTime @default(now())
}

model NotificationInbox {
  id          String @id @map("_id")
  recipientId String @db.ObjectId
  audience    String
  sequence    Int    @default(0)
}

model Notification {
  id          String    @id @map("_id")
  recipientId String    @db.ObjectId
  audience    String
  eventId     String
  kind        String
  entityId    String    @db.ObjectId
  sequence    Int
  title       String
  href        String
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  @@index([recipientId, audience, sequence])
  @@index([recipientId, audience, readAt])
}

model SupportTicket {
  id               String   @id @map("_id") @db.ObjectId
  ownerId          String   @db.ObjectId
  conversationId   String   @db.ObjectId
  initialMessageId String
  category         String
  subject          String
  state            String   @default("OPEN")
  version          Int      @default(1)
  fingerprint      String
  context          Json?
  returnCaseId     String?  @db.ObjectId
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId, createdAt])
  @@index([state, updatedAt])
}

model ReturnCase {
  id               String   @id @map("_id") @db.ObjectId
  ownerId          String   @db.ObjectId
  orderId          String   @db.ObjectId
  lineIndex        Int
  quantity         Int
  ticketId         String   @db.ObjectId
  reason           String
  preference       String
  description      String
  state            String   @default("REQUESTED")
  version          Int      @default(1)
  fingerprint      String
  item             Json
  policy           Json?
  exchange         Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([ownerId, createdAt])
  @@index([orderId, lineIndex])
  @@index([state, updatedAt])
}

model ReturnCaseEvent {
  id        String   @id @map("_id")
  caseId    String   @db.ObjectId
  actorId   String   @db.ObjectId
  action    String
  state     String
  text      String
  reference String?
  exchange  Json?
  createdAt DateTime @default(now())

  @@index([caseId, createdAt])
}

model SupportTicketNote {
  id          String   @id @map("_id")
  ticketId    String   @db.ObjectId
  actorId     String   @db.ObjectId
  text        String
  fingerprint String
  createdAt   DateTime @default(now())

  @@index([ticketId, createdAt])
}

model CustomerServiceSettings {
  id                  String   @id @map("_id")
  version             Int      @default(0)
  draft               Json?
  publishedRevisionId String?  @db.ObjectId
  updatedAt           DateTime @updatedAt
}

model CustomerServiceRevision {
  id          String   @id @map("_id") @db.ObjectId
  revision    Int
  content     Json
  publishedBy String   @db.ObjectId
  publishedAt DateTime @default(now())

  @@index([publishedAt])
}

model SupportSettings {
  id          String    @id @map("_id")
  version     Int       @default(0)
  draft       Json?
  published   Json?
  publishedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model SupportConversation {
  id                   String   @id @map("_id") @db.ObjectId
  ownerId              String   @db.ObjectId
  status               String   @default("OPEN")
  version              Int      @default(1)
  assignedTo           String?  @db.ObjectId
  sequence             Int      @default(0)
  customerReadSequence Int      @default(0)
  adminReadSequence    Int      @default(0)
  customerUnread       Int      @default(0)
  adminUnread          Int      @default(0)
  lastMessageAt        DateTime @default(now())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([status, lastMessageAt])
  @@index([assignedTo, status])
}

model SupportMessage {
  id             String   @id @map("_id")
  conversationId String   @db.ObjectId
  authorId       String   @db.ObjectId
  senderRole     String
  sequence       Int
  text           String
  fingerprint    String
  context        Json?
  attachmentId   String?  @db.ObjectId
  createdAt      DateTime @default(now())

  @@index([conversationId, sequence])
}

model SupportAttachment {
  id             String   @id @map("_id") @db.ObjectId
  conversationId String   @db.ObjectId
  uploadedBy     String   @db.ObjectId
  contentType    String
  size           Int
  bytes          Bytes
  fingerprint    String
  messageId      String?
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Category {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  name           String
  slug           String    @unique
  isVisible      Boolean   @default(true)
  specifications Json?
  products       Product[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Brand {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String    @unique
  isVisible Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String           @unique
  description String
  status      ProductStatus    @default(DRAFT)
  categoryId  String           @db.ObjectId
  brandId     String           @db.ObjectId
  category    Category         @relation(fields: [categoryId], references: [id])
  brand       Brand            @relation(fields: [brandId], references: [id])
  variants    ProductVariant[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId, status])
  @@index([brandId, status])
}

model ProductVariant {
  id              String            @id @default(auto()) @map("_id") @db.ObjectId
  productId       String            @db.ObjectId
  sku             String            @unique
  name            String
  price           Int
  currency        String            @default("vnd")
  image           Image
  attributes      Json?
  gallery         Json?
  warrantyText    String?
  packageContents String?
  isActive        Boolean           @default(true)
  inStock         Boolean           @default(false)
  inventory       VariantInventory?
  product         Product           @relation(fields: [productId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([productId, isActive])
}

type VariantInventory {
  onHand    Int
  reserved  Int
  version   Int
  updatedAt DateTime
}

model PaymentAttempt {
  id                    String    @id @map("_id")
  orderId               String    @db.ObjectId
  paymentMethod         String
  merchantId            String?
  amount                Float
  currency              String
  state                 String    @default("CREATED")
  paymentUrl            String?
  deeplink              String?
  expiresAt             DateTime?
  providerTransactionId String?
  resultCode            String?
  failureVerifiedAt     DateTime?
  previousAttemptId     String?
  exceptionPending      Boolean?
  createDate            DateTime  @default(now())
  startedAt             DateTime?
  lastCheckedAt         DateTime?
  nextCheckAt           DateTime?
  checkCount            Int       @default(0)
  lastError             String?
  leaseToken            String?
  leaseExpiresAt        DateTime?

  @@index([orderId])
  @@index([state, nextCheckAt])
  @@index([exceptionPending, state])
}

model Order {
  id                     String                 @id @default(auto()) @map("_id") @db.ObjectId
  userId                 String                 @db.ObjectId
  amount                 Float
  currency               String
  status                 String
  deliveryStatus         String?
  createDate             DateTime               @default(now())
  paymentIntentId        String?                @unique
  paymentMethod          String                 @default("VNPAY")
  paymentUrl             String?
  paymentExpiresAt       DateTime?
  paymentAttemptTracked  Boolean?
  activePaymentAttemptId String?
  paidPaymentAttemptId   String?
  products               CartProductProps[]
  address                Address?
  recipientName          String?
  recipientPhone         String?
  shippingInfo           ShippingInfo?
  codPaymentInfo         CodPaymentInfo?
  stockReservation       OrderStockReservation?
  totals                 OrderTotals?
  servicePolicies        Json?
  returnsVersion         Int?
  management             OrderManagement?
  refundInfo             OrderRefund?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

type OrderManagement {
  state     String
  version   Int
  updatedAt DateTime
}

// One full pre-dispatch cancellation/refund per order. Partial returns use a separate future flow.
type OrderRefund {
  id                    String
  state                 String
  version               Int
  amount                Float
  currency              String
  requestedBy           String   @db.ObjectId
  reason                String
  requestedAt           DateTime
  updatedAt             DateTime
  approvedBy            String?  @db.ObjectId
  decisionReason        String?
  paymentReference      String
  paymentCreatedAt      DateTime
  providerTransactionId String?
  merchantId            String?
  providerRequestId     String?
  providerRefundId      String?
  sentAt                DateTime?
  lastCheckedAt         DateTime?
  resultCode            String?
  leaseToken            String?
  leaseExpiresAt        DateTime?
  manualReference       String?
  manualOccurredAt      DateTime?
}

type ShippingInfo {
  carrier        String
  trackingNumber String
  note           String
  version        Int
  updatedAt      DateTime
}

model ShippingPolicy {
  id                    String   @id @map("_id")
  version               Int
  label                 String
  enabled               Boolean
  fee                   Int
  freeShippingThreshold Int?
  nationwide            Boolean
  provinceCodes         String[]
  updatedAt             DateTime @updatedAt
}

type OrderTotals {
  version               Int
  subtotal              Float
  shippingFee           Float
  discountTotal         Float
  grandTotal            Float
  shippingPolicyVersion Int
  shippingPolicyLabel   String
  shippingBaseFee       Float
  freeShippingThreshold Float?
  quotedAt              DateTime
  lines                 OrderTotalsLine[]
}

type OrderTotalsLine {
  variantId    String @db.ObjectId
  quantity     Int
  unitPrice    Float
  subtotal     Float
  shippingFee  Float
  discountTotal Float
  grandTotal   Float
}

type CodPaymentInfo {
  version    Int
  collection CodCollection?
  settlement CodSettlement?
}

type CodCollection {
  requestId  String
  collector  String
  amount     Float
  reference  String
  occurredAt DateTime
  note       String
  recordedAt DateTime
  recordedBy String   @db.ObjectId
}

type CodSettlement {
  requestId  String
  amount     Float
  carrierFee Float
  reference  String
  occurredAt DateTime
  note       String
  recordedAt DateTime
  recordedBy String   @db.ObjectId
}

type CartProductProps {
  id          String  @db.ObjectId
  variantId   String? @db.ObjectId
  sku         String?
  name        String
  description String
  category    String
  brand       String
  selectedImg Image
  quantity    Int
  price       Float
}

type OrderStockReservation {
  state     String
  version   Int
  expiresAt DateTime?
  updatedAt DateTime
  lines     ReservedStockLine[]
}

type ReservedStockLine {
  variantId String @db.ObjectId
  sku       String
  quantity  Int
}

type Image {
  color     String
  colorCode String
  image     String
}

type Address {
  provinceCode String?
  districtCode String?
  wardCode     String?
  city        String
  country     String
  line1       String
  line2       String?
  postal_code String
  state       String
}

model PaymentException {
  id                    String    @id @map("_id")
  orderId               String    @db.ObjectId
  attemptId             String
  paidAttemptId         String?
  reason                String
  amount                Float
  currency              String
  providerTransactionId String?
  status                String    @default("OPEN")
  note                  String?
  reviewedBy            String?   @db.ObjectId
  reviewedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([status, createdAt])
  @@index([orderId])
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}
