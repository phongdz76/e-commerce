# Copy these entries into .env.local or your hosting environment.
# Obtain all three values for the SAME sandbox app from ZaloPay.
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=

# Public storefront URL (localhost is allowed for the browser return).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public HTTPS endpoint that forwards to this app; localhost is not reachable by ZaloPay.
ZALOPAY_CALLBACK_URL=https://YOUR_PUBLIC_HOST/api/zalopay/callback

# Endpoints are fixed to sb-openapi.zalopay.vn in the server implementation.
# Never prefix KEY1 or KEY2 with NEXT_PUBLIC_.
