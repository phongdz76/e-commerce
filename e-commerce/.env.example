# Copy to a private .env file and configure the app/database and sandbox providers.
# DATABASE_URL=mongodb://127.0.0.1:27017/sgtech_local?replicaSet=rs0
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=generate-your-own-random-value
# Transactional event emails remain disabled until explicitly enabled.
SGTECH_EVENT_EMAILS_ENABLED=false
# Reuse the application's existing EMAIL_USER / EMAIL_PASSWORD sender credentials.
# EMAIL_USER=
# EMAIL_PASSWORD=
# NEXT_PUBLIC_APP_URL=http://localhost:3000
