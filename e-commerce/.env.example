# Copy into .env and fill the credentials for your own environment.
DATABASE_URL=mongodb://localhost:27017/sgtech?replicaSet=rs0
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_TRUST_PROXY=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
EMAIL_USER=
EMAIL_PASSWORD=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

VNP_TMNCODE=
VNP_HASHSECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURNURL=http://localhost:3000/api/vnpay/vnpay-return
# Register this public HTTPS URL with VNPay; env alone does not register it.
VNP_IPN_URL=
VNP_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNP_QUERY_IP=127.0.0.1

MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_API_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_QUERY_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/query
MOMO_REDIRECT_URL=http://localhost:3000/api/momo/momo-return
MOMO_IPN_URL=

ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_CALLBACK_URL=

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Random secret shared by the scheduler and /api/jobs/reconcile-payments.
CRON_SECRET=
PAYMENT_WORKER_APP_URL=http://localhost:3000
PAYMENT_WORKER_INTERVAL_MS=60000
PAYMENT_WORKER_MAX_BATCHES=3
# Portfolio demo: use Stripe sk_test_/pk_test_ and VNPay/MoMo/ZaloPay sandbox credentials.
# Operations workflow also needs SGTECH_APP_URL, SGTECH_OPERATIONS_ENABLED=true,
# GitHub Actions uses a short-lived OIDC identity restricted to this repo/main/workflow.
# A local worker can continue using CRON_SECRET.
SGTECH_GITHUB_REPOSITORY=phongdz76/e-commerce
SGTECH_GITHUB_REPOSITORY_ID=1044465509
SGTECH_GITHUB_OWNER_ID=145427852
